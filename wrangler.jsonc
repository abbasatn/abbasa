{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "abbasa",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "672cda11-ddaa-4639-8a57-671e63a939ad","database_name": "abbasa" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "033f1bb17dca49dd83e74caa88ce2641" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
